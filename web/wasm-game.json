{
  "id": "dosbox-family",
  "title": "DOSBox WASM Suite",
  "kicker": "Native DOSBox source in WebAssembly",
  "description": "Choose a Jill of the Jungle episode and play it in a contained DOS viewport.",
  "adapter": "/game-adapter.js",
  "preferencesNamespace": "dosbox-family",
  "defaultVariant": "jill1",
  "identity": false,
  "graphics": false,
  "advanced": false,
  "fullscreen": true,
  "defaultFullscreen": false,
  "pointerLock": false,
  "displayMode": "4:3",
  "canvasWidth": 960,
  "canvasHeight": 720,
  "pixelated": true,
  "syncBackbuffer": false,
  "theme": {
    "accent": "#1d4e99",
    "accent-strong": "#f4cc45",
    "border": "#3564a8",
    "panel": "rgb(8 19 42 / 96%)",
    "field": "#0d2348"
  },
  "variants": {
    "jill1": {
      "title": "Jill of the Jungle",
      "engine": "DOSBox 0.74-3",
      "description": "Episode 1 with WASD mapped to the original arrow-key movement.",
      "icon": "/assets/dosbox.ico",
      "iconPixelated": true,
      "pwa": {
        "id": "/apps/dosbox/jill1",
        "shortName": "Jill 1",
        "themeColor": "#1d4e99",
        "backgroundColor": "#050b18",
        "icons": [
          { "src": "/assets/dosbox-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
          { "src": "/assets/dosbox-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
        ]
      }
    },
    "jill2": {
      "title": "Jill Goes Underground",
      "engine": "DOSBox 0.74-3",
      "description": "Episode 2 with WASD mapped to the original arrow-key movement.",
      "icon": "/assets/dosbox.ico",
      "iconPixelated": true,
      "pwa": {
        "id": "/apps/dosbox/jill2",
        "shortName": "Jill 2",
        "themeColor": "#1d4e99",
        "backgroundColor": "#050b18",
        "icons": [
          { "src": "/assets/dosbox-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
          { "src": "/assets/dosbox-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
        ]
      }
    },
    "jill3": {
      "title": "Jill Saves the Prince",
      "engine": "DOSBox 0.74-3",
      "description": "Episode 3 with WASD mapped to the original arrow-key movement.",
      "icon": "/assets/dosbox.ico",
      "iconPixelated": true,
      "pwa": {
        "id": "/apps/dosbox/jill3",
        "shortName": "Jill 3",
        "themeColor": "#1d4e99",
        "backgroundColor": "#050b18",
        "icons": [
          { "src": "/assets/dosbox-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
          { "src": "/assets/dosbox-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
        ]
      }
    }
  }
}

